enum(string) Direction {
	Down = "down",
	Up = "up",
	North = "north",
	East = "east",
	South = "south",
	West = "west",
}

enum(string) VerticalDirection {
	Down = "down",
	Up = "up",
}

enum(byte) DirectionByte {
	Down = 0b,
	Up = 1b,
	North = 2b,
	South = 3b,
	West = 4b,
	East = 5b,
}

enum(byte) HorizontalDirectionByte {
	South = 0b,
	West = 1b,
	North = 2b,
	East = 3b,
}

enum(int) DirectionInt {
	Down = 0,
	Up = 1,
	North = 2,
	South = 3,
	West = 4,
	East = 5,
}

enum(string) Axis {
	X = "x",
	Y = "y",
	Z = "z",
}
