struct Saddled {
	...super::Breedable,
	/// Whether there is a saddle on it.
	#[until="1.21.5"]
	Saddle?: boolean,
	#[since="26.4"]
	item_based_steering?: ItemBasedSteering,
}

struct ItemBasedSteering {
	boosting?: boolean,
	boost_time?: int,
	boost_time_total?: int,
}

dispatch minecraft:entity[pig] to struct Pig {
	...Saddled,
	#[since="1.21.5"]
	variant?: #[id="pig_variant"] string,
	#[since="26.1"]
	sound_variant?: #[id="pig_sound_variant"] string,
}

#[since="1.16"]
dispatch minecraft:entity[strider] to Saddled
