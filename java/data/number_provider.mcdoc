use ::java::data::enchantment::LevelBasedValue
use ::java::data::predicate::PredicateRef
use ::java::data::worldgen::attribute::NumericalEnvironmentAttribute
use ::java::data::util::ScoreProvider
use ::java::util::NonEmptyWeightedList

#[since="26.3"]
dispatch minecraft:resource[number_provider] to NumberProvider

// Since 1.17
// NumberProviders.DIRECT_CODEC in 26.3-snapshot-3
type NumberProvider = (
	float |
	#[until="26.3"] struct {
		/// Defaults to `minecraft:uniform`.
		type?: #[id="loot_number_provider_type"] string,
		...minecraft:number_provider[[type]],
	} |
	#[since="26.3"] struct {
		type: #[id="loot_number_provider_type"] string,
		...minecraft:number_provider[[type]],
	} |
)

type NumberProviderRef = (
	NumberProvider |
	#[since="26.3"] #[id="number_provider"] string |
)
type NumberProviderListRef = (
	#[until="26.3"] [NumberProvider] |
	#[since="26.3"] NumberProvider |
	#[since="26.3"] #[id=(registry="number_provider",tags="allowed")] string |
	#[since="26.3"] [(#[id="number_provider"] string | NumberProvider)] |
)
// Since 26.3
type ResolvableNumber = (
	float |
	#[id="number_provider"] string |
)
// Since 26.3, non-empty version of NumberProviderListRef
type AggregateOperands = (
	NumberProvider |
	// TODO: disallow empty tag
	#[id=(registry="number_provider",tags="allowed")] string |
	[(#[id="number_provider"] string | NumberProvider)] @ 1.. |
)

dispatch minecraft:number_provider[uniform] to UniformNumberProvider
#[until="26.3"]
dispatch minecraft:number_provider[%none] to UniformNumberProvider

struct UniformNumberProvider {
	min?: NumberProviderRef,
	max?: NumberProviderRef,
}

dispatch minecraft:number_provider[binomial] to struct BinomialNumberProvider {
	n: NumberProviderRef,
	p: NumberProviderRef,
}

#[since="26.3"]
dispatch minecraft:number_provider[conditional] to struct ConditionalNumberProvider {
	condition: PredicateRef,
	on_true: NumberProviderRef,
	/// Defaults to constant 0.
	on_false?: NumberProviderRef,
}

dispatch minecraft:number_provider[constant] to struct ConstantNumberProvider {
	value: float,
}

dispatch minecraft:number_provider[enchantment_level] to struct EnchantmentLevelProvider {
	amount: LevelBasedValue,
}

#[since="26.1"]
dispatch minecraft:number_provider[environment_attribute] to struct EnvironmentAttributeNumberProvider {
	attribute: NumericalEnvironmentAttribute,
}

#[since="26.3"]
dispatch minecraft:number_provider[number_dispatcher] to struct NumberDispatcher {
	cases: [struct {
		// Ok I give up disallowing references
		// We need a new solution for this
		// TODO: disallow references in some registries
		condition: PredicateRef,
		number_provider: NumberProviderRef,
	}],
	/// Defaults to constant 0.
	default?: NumberProviderRef,
}

dispatch minecraft:number_provider[score] to struct ScoreNumberProvider {
	target: ScoreProvider,
	score: #[objective] string,
	scale?: float,
}

dispatch minecraft:number_provider[storage] to struct StorageNumberProvider {
	storage: #[id="storage"] string,
	path: #[nbt_path=minecraft:storage[[source]]] string,
}

#[since="26.1"]
dispatch minecraft:number_provider[sum] to AggregateNumberProvider
#[since="26.3"]
dispatch minecraft:number_provider[average, maximum, minimum, product] to AggregateNumberProvider

struct AggregateNumberProvider {
	#[until="26.3"]
	summands: NumberProviderListRef,
	#[since="26.3"]
	operands: AggregateOperands,
}

#[since="26.3"]
dispatch minecraft:number_provider[weighted_list] to struct WeightedNumberProvider {
	distribution: NonEmptyWeightedList<NumberProviderRef>,
}
