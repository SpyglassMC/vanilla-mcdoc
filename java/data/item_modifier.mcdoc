use super::loot::LootFunction

// Note: because sequence can be inlined, slot source doesn't need any -Ref types here.
// Use ItemModifier instead.
type ItemModifier = (
	LootFunction |
	#[until="26.3"] [LootFunction] |
	#[since="26.3"] [ItemModifier] |
	#[since="26.3"] #[id=(registry="item_modifier",tags="allowed")] string |
	// ↓ This is covered by [ItemModifier]
	// #[since="26.3"] [#[id="item_modifier"] string] |
)
type ItemModifierRoot = (
	#[until="26.3"] ItemModifier |
	#[since="26.3"] LootFunction |
)
// Used by item modifier command argument
type ItemModifierArgument = ItemModifier

// Since 26.3
// Janky workaround before we have proper "context" attributes to handle this.
type ItemModifierWithoutRootRef = (
	LootFunction |
	[ItemModifierWithoutRootRef] |
)

#[since="1.17"]
dispatch minecraft:resource[item_modifier] to ItemModifierRoot
