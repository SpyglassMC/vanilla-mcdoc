use ::java::data::predicate::PredicateRef
use ::java::data::worldgen::attribute::IntegerEnvironmentAttribute
use ::java::data::util::ScoreProvider
use ::java::util::NonEmptyWeightedList
use super::context_float::FloatRef

#[since="26.3"]
dispatch minecraft:resource[context_int_provider] to ContextIntProvider

type ContextIntProvider = (
	int |
	struct {
		type: #[id="context_int_provider_type"] string,
		...minecraft:context_int_provider[[type]],
	} |
)

type IntRef = (
	#[id="context_int_provider"] string |
	ContextIntProvider |
)
type AggregateOperands = (
	ContextIntProvider |
	// TODO: disallow empty tag
	#[id=(registry="context_int_provider",tags="allowed")] string |
	[IntRef] @ 1.. |
)

type SingleProvider = super::SingleProvider<IntRef>
type BinaryProvider = super::BinaryProvider<IntRef>
type AggregateProvider = super::AggregateProvider<AggregateOperands>

// Basic Operations

dispatch minecraft:context_int_provider[add] to AggregateProvider

/// Subtract
dispatch minecraft:context_int_provider[sub] to BinaryProvider

/// Multiply
dispatch minecraft:context_int_provider[mul] to AggregateProvider

/// Absolute Value
dispatch minecraft:context_int_provider[abs] to SingleProvider

dispatch minecraft:context_int_provider[negate] to SingleProvider

// Integer Division

/// Floored Divide. Rounds towards `-∞`, usually more useful when dealing with coordinates.
dispatch minecraft:context_int_provider[floor_div] to BinaryProvider

/// Divide. Truncates result (rounds towards `0`), usually less useful when dealing with coordinates.
dispatch minecraft:context_int_provider[div] to BinaryProvider

/// Floored Division Modulo
///
/// Usually more useful when dealing with coordinates. Solves for `x`:
///
/// `(floor_div(left, right) * right) + x = left`
///
/// Example:
///
/// `floor_mod(-5, 2)` = 1 (`(floor_div(-5, 2) * 2) + 1 = (-3 * 2) + 1 = -5`)
dispatch minecraft:context_int_provider[floor_mod] to BinaryProvider

/// Modulo
///
/// Uses truncated integer division, usually less useful when dealing with coordinates. Solves for `x`:
///
/// `(div(left, right) * right) + x = left`
///
/// Example:
///
/// `mod(-5, 2)` = -1 (`(div(-5, 2) * 2) + (-1) = (-2 * 2) + (-1) = -5`)
dispatch minecraft:context_int_provider[mod] to BinaryProvider

// Composite Operations

/// Average. Division result is truncated (rounded towards `0`).
dispatch minecraft:context_int_provider[avg] to AggregateProvider

/// Exponentiate. Fails if the exponent is negative.
dispatch minecraft:context_int_provider[pow] to super::PowerProvider<IntRef>

// Conditonal Operations

dispatch minecraft:context_int_provider[max, min] to AggregateProvider

// Domain-specific Conditional Providers

dispatch minecraft:context_int_provider[conditional] to super::ConditionalProvider<IntRef>

/// Dispatched
dispatch minecraft:context_int_provider[number_dispatcher] to super::DispatcherProvider<IntRef>

dispatch minecraft:context_int_provider[weighted_list] to super::DistributionProvider<IntRef>

// Domain-specific Providers

dispatch minecraft:context_int_provider[constant] to super::ConstantValue<int>

/// Makes `n` random coin flips with probability of succeeding equal to `p`, then returns number of successes.
dispatch minecraft:context_int_provider[binomial] to struct BinomialDistributionGenerator {
	/// Number of coin flips.
	n: IntRef,
	/// Probability of a single coin flip succeeding.
	p: FloatRef,
}

dispatch minecraft:context_int_provider[uniform] to super::RandomProvider<IntRef>

dispatch minecraft:context_int_provider[from_float] to super::SingleProvider<FloatRef>

dispatch minecraft:context_int_provider[score] to struct ScoreboardValue {
	target: ScoreProvider,
	score: #[objective] string,
	/// Defaults to constant 0.
	fallback?: IntRef,
}

/// Data Storage
dispatch minecraft:context_int_provider[storage] to super::DataStorageProvider<IntRef>

/// Note: \
/// Minecraft doesn't have integer environment attributes for now. \
/// Use `from_float` provider to convert float environment attributes to integer.
dispatch minecraft:context_int_provider[environment_attribute] to super::EnvironmentAttributeProvider<IntegerEnvironmentAttribute>
