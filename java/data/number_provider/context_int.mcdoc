use ::java::data::predicate::PredicateRef
use ::java::data::worldgen::attribute::IntegerEnvironmentAttribute
use ::java::data::util::ScoreProvider
use ::java::util::NonEmptyWeightedList
use super::context_float::FloatRef

#[since="26.3"]
dispatch minecraft:resource[context_int_provider] to ContextIntProvider

type ContextIntProvider = (
	int |
	struct {
		type: #[id="context_int_provider_type"] string,
		...minecraft:context_int_provider[[type]],
	} |
)

type IntRef = (
	#[id="context_int_provider"] string |
	ContextIntProvider |
)
type AggregateOperands = (
	ContextIntProvider |
	// TODO: disallow empty tag
	#[id=(registry="context_int_provider",tags="allowed")] string |
	[IntRef] @ 1.. |
)

type AggregateProvider = super::AggregateProvider<AggregateOperands>
type BinaryProvider = super::BinaryProvider<IntRef>
type ConditionalProvider = super::ConditionalProvider<IntRef>
type ConstantValue = super::ConstantValue<int>
type DispatcherProvider = super::DispatcherProvider<IntRef>
type DistributionProvider = super::DistributionProvider<IntRef>
type EnvironmentAttributeProvider = super::EnvironmentAttributeProvider<IntegerEnvironmentAttribute>
type PowerProvider = super::PowerProvider<IntRef>
type RangeProvider = super::PowerProvider<IntRef>
type StorageValue = super::StorageValue<IntRef>
type UnaryProvider = super::UnaryProvider<IntRef>

type CastFromFloat = super::UnaryProvider<FloatRef>

// Basic Operations

dispatch minecraft:context_int_provider[add, mul] to AggregateProvider

dispatch minecraft:context_int_provider[sub] to BinaryProvider

dispatch minecraft:context_int_provider[abs, negate] to UnaryProvider

// Integer Division

/// Floors result (rounds towards `-∞`), usually more useful when dealing with coordinates.
dispatch minecraft:context_int_provider[floor_div] to BinaryProvider

/// Truncates result (rounds towards `0`), usually less useful when dealing with coordinates.
dispatch minecraft:context_int_provider[div] to BinaryProvider

/// Uses floored integer division, usually more useful when dealing with coordinates.
///
/// Solves for `x`: `(floor_div(left, right) * right) + x = left`
///
/// Example: `floor_mod(-5, 2)` = 1 (`(floor_div(-5, 2) * 2) + 1 = (-3 * 2) + 1 = -5`)
dispatch minecraft:context_int_provider[floor_mod] to BinaryProvider

/// Uses truncated integer division, usually less useful when dealing with coordinates.
///
/// Solves for `x`: `(div(left, right) * right) + x = left`
///
/// Example: `mod(-5, 2)` = -1 (`(div(-5, 2) * 2) + (-1) = (-2 * 2) + (-1) = -5`)
dispatch minecraft:context_int_provider[mod] to BinaryProvider

// Composite Operations

/// Division result is truncated (rounds towards `0`).
dispatch minecraft:context_int_provider[avg] to AggregateProvider

/// Fails if the exponent is negative.
dispatch minecraft:context_int_provider[pow] to PowerProvider

// Conditonal Operations

dispatch minecraft:context_int_provider[max, min] to AggregateProvider

// Domain-specific Conditional Providers

dispatch minecraft:context_int_provider[conditional] to ConditionalProvider

dispatch minecraft:context_int_provider[number_dispatcher] to DispatcherProvider

dispatch minecraft:context_int_provider[weighted_list] to DistributionProvider

// Domain-specific Providers

dispatch minecraft:context_int_provider[constant] to ConstantValue

/// Makes `n` random coin flips with probability of succeeding equal to `p`, then returns number of successes.
dispatch minecraft:context_int_provider[binomial] to struct BinomialDistributionGenerator {
	/// Number of coin flips.
	n: IntRef,
	/// Probability of a single coin flip succeeding.
	p: FloatRef,
}

dispatch minecraft:context_int_provider[uniform] to RangeProvider

dispatch minecraft:context_int_provider[from_float] to CastFromFloat

dispatch minecraft:context_int_provider[score] to struct ScoreboardValue {
	target: ScoreProvider,
	score: #[objective] string,
	/// Defaults to constant 0.
	fallback?: IntRef,
}

/// Note: \
/// Minecraft doesn't have integer environment attributes for now. \
/// Use `from_float` provider to convert float environment attributes to integer.
dispatch minecraft:context_int_provider[environment_attribute] to EnvironmentAttributeProvider
