use ::java::data::predicate::PredicateRef
use ::java::data::worldgen::attribute::IntegerEnvironmentAttribute
use ::java::data::util::ScoreProvider
use ::java::util::NonEmptyWeightedList
use super::contextual_float::ContextFloatRef

#[since="26.3"]
dispatch minecraft:resource[context_int_provider] to IntegerNumberProvider

type IntegerNumberProvider = (
	int |
	struct {
		type: #[id="context_int_provider_type"] string,
		...minecraft:number_provider/integer[[type]],
	} |
)

type ContextIntRef = (
	#[id="context_int_provider"] string |
	IntegerNumberProvider |
)
type ContextIntListRef = (
	IntegerNumberProvider |
	#[id=(registry="context_int_provider",tags="allowed")] string |
	[ContextIntRef] |
)

type AggregateProvider = super::AggregateProvider<ContextIntListRef>
type BinaryProvider = super::BinaryProvider<ContextIntRef>
type ConditionalProvider = super::ConditionalProvider<ContextIntRef>
type ConstantValue = super::ConstantValue<int>
type DispatcherProvider = super::DispatcherProvider<ContextIntRef>
type DistributionProvider = super::DistributionProvider<ContextIntRef>
type EnvironmentAttributeProvider = super::EnvironmentAttributeProvider<IntegerEnvironmentAttribute>
type PowerProvider = super::PowerProvider<ContextIntRef>
type RangeProvider = super::PowerProvider<ContextIntRef>
type StorageValue = super::StorageValue<ContextIntRef>
type UnaryProvider = super::UnaryProvider<ContextIntRef>

type CastFromFloat = super::UnaryProvider<ContextFloatRef>

// Basic Operations

dispatch minecraft:number_provider/integer[add, mul] to AggregateProvider

dispatch minecraft:number_provider/integer[sub] to BinaryProvider

dispatch minecraft:number_provider/integer[abs, negate] to UnaryProvider

// Integer Division

/// Floors result (rounds towards `-∞`), usually more useful when dealing with coordinates.
dispatch minecraft:number_provider/integer[floor_div] to BinaryProvider

/// Truncates result (rounds towards `0`), usually less useful when dealing with coordinates.
dispatch minecraft:number_provider/integer[div] to BinaryProvider

/// Uses floored integer division, usually more useful when dealing with coordinates.
///
/// Solves for `x`: `(floor_div(left, right) * right) + x = left`
///
/// Example: `floor_mod(-5, 2)` = 1 (`(floor_div(-5, 2) * 2) + 1 = (-3 * 2) + 1 = -5`)
dispatch minecraft:number_provider/integer[floor_mod] to BinaryProvider

/// Uses truncated integer division, usually less useful when dealing with coordinates.
///
/// Solves for `x`: `(div(left, right) * right) + x = left`
///
/// Example: `mod(-5, 2)` = -1 (`(div(-5, 2) * 2) + (-1) = (-2 * 2) + (-1) = -5`)
dispatch minecraft:number_provider/integer[mod] to BinaryProvider

// Composite Operations

/// Division result is truncated (rounds towards `0`).
dispatch minecraft:number_provider/integer[avg] to AggregateProvider

/// Fails if the exponent is negative.
dispatch minecraft:number_provider/integer[pow] to PowerProvider

// Conditonal Operations

dispatch minecraft:number_provider/integer[max, min] to AggregateProvider

// Domain-specific Conditional Providers

dispatch minecraft:number_provider/integer[conditional] to ConditionalProvider

dispatch minecraft:number_provider/integer[number_dispatcher] to DispatcherProvider

dispatch minecraft:number_provider/integer[weighted_list] to DistributionProvider

// Domain-specific Providers

dispatch minecraft:number_provider/integer[constant] to ConstantValue

/// Makes `n` random coin flips with probability of succeeding equal to `p`, then returns number of successes.
dispatch minecraft:number_provider/integer[binomial] to struct BinomialDistributionGenerator {
	/// Number of coin flips.
	n: ContextIntRef,
	/// Probability of a single coin flip succeeding.
	p: ContextFloatRef,
}

dispatch minecraft:number_provider/integer[uniform] to RangeProvider

dispatch minecraft:number_provider/integer[from_float] to CastFromFloat

dispatch minecraft:number_provider/integer[score] to struct ScoreboardValue {
	target: ScoreProvider,
	score: #[objective] string,
	/// Defaults to constant 0.
	fallback?: ContextIntRef,
}

/// Note: \
/// Minecraft doesn't have integer environment attributes for now. \
/// Use `from_float` provider to convert float environment attributes to integer.
dispatch minecraft:number_provider/integer[environment_attribute] to EnvironmentAttributeProvider
