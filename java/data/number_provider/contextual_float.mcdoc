use ::java::data::enchantment::LevelBasedValue
use ::java::data::predicate::PredicateRef
use ::java::data::worldgen::attribute::NumericalEnvironmentAttribute
use ::java::util::NonEmptyWeightedList
use super::contextual_integer::ContextIntRef

#[since="26.3"]
dispatch minecraft:resource[context_float_provider] to FloatNumberProvider

type FloatNumberProvider = (
	float |
	struct {
		type: #[id="context_float_provider_type"] string,
		...minecraft:number_provider/float[[type]],
	} |
)

type ContextFloatRef = (
	#[id="context_float_provider"] string |
	FloatNumberProvider |
)
type ContextFloatListRef = (
	FloatNumberProvider |
	#[id=(registry="context_int_provider",tags="allowed")] string |
	[ContextFloatRef] |
)

type AggregateProvider = super::AggregateProvider<ContextFloatListRef>
type BinaryProvider = super::BinaryProvider<ContextFloatRef>
type ConditionalProvider = super::ConditionalProvider<ContextFloatRef>
type ConstantValue = super::ConstantValue<float>
type DispatcherProvider = super::DispatcherProvider<ContextFloatRef>
type DistributionProvider = super::DistributionProvider<ContextFloatRef>
type EnvironmentAttributeProvider = super::EnvironmentAttributeProvider<NumericalEnvironmentAttribute>
type PowerProvider = super::PowerProvider<ContextFloatRef>
type RangeProvider = super::PowerProvider<ContextFloatRef>
type StorageValue = super::StorageValue<ContextFloatRef>
type UnaryProvider = super::UnaryProvider<ContextFloatRef>

type CastFromInt = super::UnaryProvider<ContextIntRef>

// Basic Operations

dispatch minecraft:number_provider/float[add, mul] to AggregateProvider

dispatch minecraft:number_provider/float[sub, div, mod] to BinaryProvider

dispatch minecraft:number_provider/float[abs, negate] to UnaryProvider

// Composite Operations

dispatch minecraft:number_provider/float[avg, length] to AggregateProvider

dispatch minecraft:number_provider/float[pow] to PowerProvider

dispatch minecraft:number_provider/float[sqrt] to UnaryProvider

// Trigonometric Operations

dispatch minecraft:number_provider/float[sin, cos] to UnaryProvider

// Conditonal Operations

dispatch minecraft:number_provider/float[ceil, floor, round, truncate] to UnaryProvider

dispatch minecraft:number_provider/float[max, min] to AggregateProvider

// Domain-specific Conditional Providers

dispatch minecraft:number_provider/float[conditional] to ConditionalProvider

dispatch minecraft:number_provider/float[number_dispatcher] to DispatcherProvider

dispatch minecraft:number_provider/float[weighted_list] to DistributionProvider

// Domain-specific Providers

dispatch minecraft:number_provider/float[constant] to ConstantValue

dispatch minecraft:number_provider/float[uniform] to RangeProvider

dispatch minecraft:number_provider/float[from_int] to CastFromInt

dispatch minecraft:number_provider/float[storage] to StorageValue

dispatch minecraft:number_provider/float[enchantment_level] to struct EnchantmentLevelProvider {
	amount: LevelBasedValue,
}

dispatch minecraft:number_provider/float[environment_attribute] to EnvironmentAttributeProvider
