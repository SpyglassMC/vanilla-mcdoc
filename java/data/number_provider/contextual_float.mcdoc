use ::java::data::enchantment::LevelBasedValue
use ::java::data::predicate::PredicateRef
use ::java::data::worldgen::attribute::NumericalEnvironmentAttribute
use ::java::util::NonEmptyWeightedList

#[since="26.3"]
dispatch minecraft:resource[context_float_provider] to FloatNumberProvider

type FloatNumberProvider = (
	float |
	struct {
		type: #[id="context_float_provider_type"] string,
		...minecraft:number_provider/float[[type]],
	} |
)

type FloatNumberProviderRef = (
	#[id="context_float_provider"] string |
	FloatNumberProvider |
)

struct SingleInputFloat {
	input: FloatNumberProviderRef,
}

struct MultiInputFloat {
	inputs: [FloatNumberProviderRef] @ 2..,
}

struct SidedInputsFloat {
	left: FloatNumberProviderRef,
	right: FloatNumberProviderRef,
}

// Basic Operations

dispatch minecraft:number_provider/float[add] to struct AddFloatProvider {
	...MultiInputFloat,
}

dispatch minecraft:number_provider/float[sub] to struct SubtractFloatProvider {
	...SidedInputsFloat,
}

dispatch minecraft:number_provider/float[mul] to struct MultiplyFloatProvider {
	...MultiInputFloat,
}

dispatch minecraft:number_provider/float[abs] to struct AbsoluteFloatProvider {
	...SingleInputFloat,
}

dispatch minecraft:number_provider/float[negate] to struct NegateFloatProvider {
	...SingleInputFloat,
}

dispatch minecraft:number_provider/float[div] to struct DivideFloatProvider {
	...SidedInputsFloat,
}

dispatch minecraft:number_provider/float[mod] to struct ModuloFloatProvider {
	...SidedInputsFloat,
}

// Composite Operations

dispatch minecraft:number_provider/float[avg] to struct AverageFloatProvider {
	...MultiInputFloat,
}

dispatch minecraft:number_provider/float[pow] to struct ExponentiateFloatProvider {
	base: FloatNumberProviderRef,
	exponent: FloatNumberProviderRef,
}

dispatch minecraft:number_provider/float[sqrt] to struct SquareRootFloatProvider {
	...SingleInputFloat,
}

dispatch minecraft:number_provider/float[length] to struct VectorLengthFloatProvider {
	...MultiInputFloat,
}

// Trigonometric Operations

dispatch minecraft:number_provider/float[sin] to struct SineFloatProvider {
	...SingleInputFloat,
}

dispatch minecraft:number_provider/float[cos] to struct CosineFloatProvider {
	...SingleInputFloat,
}

// Conditonal Operations

dispatch minecraft:number_provider/float[round] to struct RoundFloatProvider {
	...SingleInputFloat,
}

dispatch minecraft:number_provider/float[floor] to struct FloorFloatProvider {
	...SingleInputFloat,
}

dispatch minecraft:number_provider/float[truncate] to struct TruncateFloatProvider {
	...SingleInputFloat,
}

dispatch minecraft:number_provider/float[ceil] to struct CeilingFloatProvider {
	...SingleInputFloat,
}

dispatch minecraft:number_provider/float[max] to struct MaxOfSetFloatProvider {
	...MultiInputFloat,
}

dispatch minecraft:number_provider/float[min] to struct MinOfSetFloatProvider {
	...MultiInputFloat,
}

// Domain-specific Conditional Providers

dispatch minecraft:number_provider/float[conditional] to struct ConditionalFloatProvider {
	condition: PredicateRef,
	on_true: FloatNumberProviderRef,
	/// Defaults to `0.0`.
	on_false?: FloatNumberProviderRef,
}

dispatch minecraft:number_provider/float[number_dispatcher] to struct DispatchedFloatProvider {
	cases: [struct DispatcherCase {
		condition: PredicateRef,
		value: FloatNumberProviderRef,
	}],
	/// Defaults to `0.0`.
	default?: FloatNumberProviderRef,
}

dispatch minecraft:number_provider/float[weighted_list] to struct WeightedListFloatProvider {
	distribution: NonEmptyWeightedList<FloatNumberProviderRef>
}

// Domain-specific Providers

dispatch minecraft:number_provider/float[constant] to struct ConstantFloatProvider {
	value: float,
}

dispatch minecraft:number_provider/float[uniform] to struct RandomFloatProvider {
	min?: FloatNumberProviderRef,
	max?: FloatNumberProviderRef,
}

dispatch minecraft:number_provider/float[from_int] to super::contextual_integer::SingleInputInteger

dispatch minecraft:number_provider/float[storage] to struct DataStorageFloatProvider {
	storage: #[id="storage"] string,
	path: #[nbt_path=minecraft:storage[[source]]] string,
	fallback?: FloatNumberProviderRef,
}

dispatch minecraft:number_provider/float[enchantment_level] to struct EnchantmentLevelFloatProvider {
	amount: LevelBasedValue,
}

dispatch minecraft:number_provider/float[environment_attribute] to struct EnvironmentAttributeFloatProvider {
	attribute: NumericalEnvironmentAttribute,
}
