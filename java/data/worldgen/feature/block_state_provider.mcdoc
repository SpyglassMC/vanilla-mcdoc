use super::super::IntProvider
use super::super::dimension::biome_source::NoiseParameters
use super::RuleBasedBlockStateProvider
use ::java::util::block_state::BlockState
use ::java::util::direction::Direction
use ::java::util::InclusiveRange
use ::java::util::NonEmptyWeightedList

struct BlockStateProvider {
	type: #[id="worldgen/block_state_provider_type"] string,
	...minecraft:block_state_provider[[type]],
}

struct BaseNoiseProvider {
	seed: #[random] int,
	noise: NoiseParameters,
	scale: float @ 0..,
}

#[since="26.3"]
dispatch minecraft:block_state_provider[copy_properties] to struct CopyPropertiesProvider {
	source: BlockStateProvider,
}

struct DualNoiseProvider {
	...BaseNoiseProvider,
	variety: InclusiveRange<int @ 1..64>,
	slow_noise: NoiseParameters,
	slow_scale: float @ 0..,
	states: [BlockState],
}

#[since="1.18"] #[until="26.3"]
dispatch minecraft:block_state_provider[dual_noise_provider] to DualNoiseProvider

#[since="26.3"]
dispatch minecraft:block_state_provider[dual_noise] to DualNoiseProvider

struct NoiseThresholdProvider {
	...BaseNoiseProvider,
	threshold: float @ -1..1,
	high_chance: float @ 0..1,
	default_state: BlockState,
	low_states: [BlockState],
	high_states: [BlockState],
}

#[since="1.18"] #[until="26.3"]
dispatch minecraft:block_state_provider[noise_threshold_provider] to NoiseThresholdProvider

#[since="26.3"]
dispatch minecraft:block_state_provider[noise_threshold] to NoiseThresholdProvider

struct NoiseProvider {
	...BaseNoiseProvider,
	states: [BlockState],
}

#[since="1.18"] #[until="26.3"]
dispatch minecraft:block_state_provider[noise_provider] to NoiseProvider

#[since="26.3"]
dispatch minecraft:block_state_provider[noise] to NoiseProvider

struct RandomizedIntStateProvider {
	property: string,
	values: IntProvider<int>,
	source: BlockStateProvider,
}

#[since="1.17"] #[until="26.3"]
dispatch minecraft:block_state_provider[randomized_int_state_provider] to RandomizedIntStateProvider

#[since="26.3"]
dispatch minecraft:block_state_provider[randomized_int_state] to RandomizedIntStateProvider

#[since="26.3"]
dispatch minecraft:block_state_provider[random_block] to struct RandomBlockStateProvider {
	blocks: (#[id=(registry="block",tags="allowed")] string | [#[id="block"] string]),
}

struct RotatedStateProvider {
	state: (
		#[until="26.3"] BlockState |
		#[since="26.3"] BlockStateProvider |
	),
	#[since="26.3"]
	direction?: Direction,
}

#[until="26.3"]
dispatch minecraft:block_state_provider[rotated_block_provider] to RotatedStateProvider

#[since="26.3"]
dispatch minecraft:block_state_provider[rotated_block] to RotatedStateProvider

struct SimpleStateProvider {
	state: BlockState,
}

#[until="26.3"]
dispatch minecraft:block_state_provider[simple_state_provider] to SimpleStateProvider

#[since="26.3"]
dispatch minecraft:block_state_provider[simple_state] to SimpleStateProvider

#[since="26.1"] #[until="26.3"]
dispatch minecraft:block_state_provider[rule_based_state_provider] to RuleBasedBlockStateProvider

#[since="26.3"]
dispatch minecraft:block_state_provider[rule_based_state] to RuleBasedBlockStateProvider

struct WeightedBlockStateProvider {
	entries: NonEmptyWeightedList<BlockState>,
}

#[until="26.3"]
dispatch minecraft:block_state_provider[weighted_state_provider] to WeightedBlockStateProvider

#[since="26.3"]
dispatch minecraft:block_state_provider[weighted_state] to WeightedBlockStateProvider
