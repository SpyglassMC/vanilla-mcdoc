use super::SoundVariant
use ::java::data::util::SoundEventRef

#[since="1.21.5"]
dispatch minecraft:resource[pig_variant] to struct PigVariant {
	model?: PigModelType,
	/// The pig texture to use for this variant.
	asset_id: #[id="texture"] string,
	/// The baby pig texture to use for this variant.
	#[since="26.1"]
	baby_asset_id: #[id="texture"] string,
	...super::SpawnPrioritySelectors,
}

#[since="26.1"]
dispatch minecraft:resource[pig_sound_variant] to (
	#[until="26.4"] SoundVariant<PigSounds> |
	#[since="26.4"] SoundVariant<OptionalPigSounds> |
)

struct PigSounds {
	ambient_sound: SoundEventRef,
	hurt_sound: SoundEventRef,
	death_sound: SoundEventRef,
	step_sound: SoundEventRef,
	eat_sound: SoundEventRef,
}
struct OptionalPigSounds {
	ambient_sound?: SoundEventRef,
	hurt_sound?: SoundEventRef,
	death_sound?: SoundEventRef,
	step_sound?: SoundEventRef,
	eat_sound?: SoundEventRef,
}

enum(string) PigModelType {
	Normal = "normal",
	Cold = "cold",
}
